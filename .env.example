# ========================================
# Auto-Jira — Environment Variables
# ========================================
# Copie este arquivo para .env e preencha
# No Railway: configure em Variables

# ── Telegram Bot (obrigatorio) ──
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Telegram Forum Topics (obrigatorio para msgs nos topicos) ──
# IDs criados via scripts/setup_telegram_topics.py
TOPIC_JIRA=208
TOPIC_MEV=209
TOPIC_SHIELDFINANCE=210
TOPIC_CHAT=211
TOPIC_NEWS=212
TOPIC_WHALE=213
TOPIC_CRYPTO=214
TOPIC_PANIC=215
TOPIC_CLIENTS=229
TOPIC_DOCS=230

# ── Jira Cloud (obrigatorio) ──
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=KAN

# ── Webhook Security (opcional) ──
WEBHOOK_SECRET=your-random-secret-here
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# ── Owner Telegram (unico user autorizado no bot) ──
OWNER_TELEGRAM_ID=1337538171

# ── OpenAI Chat AI (opcional, para /ai e mensagens livres) ──
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# ── API Auth + Cron Auth (obrigatorio para /api/* e /cron/*) ──
APP_SECRET_KEY=your-app-secret-key
# CRON_SECRET=  (opcional, usa APP_SECRET_KEY se vazio)
