# ========================================
# Auto-Jira — Environment Variables
# ========================================
# Copie este arquivo para .env e preencha
# No Railway: configure em Variables

# Telegram Bot (obrigatorio)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Jira (obrigatorio)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=KAN

# Webhook Security — Jira (opcional)
WEBHOOK_SECRET=your-random-secret-here

# Seguranca — Telegram webhook secret (obrigatorio para bot interativo)
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Seguranca — Owner (unico user autorizado no bot)
OWNER_TELEGRAM_ID=1337538171

# OpenAI — Chat AI via Telegram (obrigatorio para /chat e mensagens livres)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# API Middleware — Auth para ChatGPT Action (obrigatorio para /api/* routes)
APP_SECRET_KEY=your-app-secret-key
